<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/text-message.png">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="form-page">
    <div class="form-container">
        <h2>Escribir mensaje</h2>

        <form method="POST" action="/new" class="modern-form">
            <div class="input-group">
                <label for="messageUser">Nombre de usuario</label>
                <input type="text" id="messageUser" name="messageUser" placeholder="Ej. Carlos" required
                    autocomplete="off">
            </div>

            <div class="input-group">
                <label for="messageText">Tu mensaje</label>
                <textarea id="messageText" name="messageText" placeholder="¿Qué quieres compartir hoy?" rows="4"
                    required></textarea>
            </div>

            <div class="form-actions">
                <a href="/" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Publicar</button>
            </div>
        </form>
    </div>
</body>

</html>